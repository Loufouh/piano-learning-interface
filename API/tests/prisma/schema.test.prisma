
model User {
  id          Int    @id @default(autoincrement())
  name        String
  email       String @unique
  password    String
  isManager   Boolean @default(false)

  spaceItemsOnUsers SpaceItemsOnUsers[]

  @@map("user")
}

model SpaceItem {
  id    Int @id @default(autoincrement())
  text  String

  spaceItemsOnUsers SpaceItemsOnUsers[]

  @@map("spaceItem")
}

model SpaceItemsOnUsers {
  order       Int

  user User @relation(fields: [userId], references: [id])
  userId      Int

  spaceItem SpaceItem @relation(fields: [spaceItemId], references: [id])
  spaceItemId Int

  @@id([userId, spaceItemId])
  @@map("spaceItemsOnUsers")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider    = "sqlite"
  url         = env("DB_URL")
}

generator seed {
  provider = "prisma-client-js"
}