
model User {
  id        Int    @id @default(autoincrement())
  name      String
  email     String @unique
  password  String
  isManager Boolean @default(false)
  @@map("user")
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider    = "postgres"
  url         = env("DB_URL")
}

generator seed {
  provider = "prisma-client-js"
}